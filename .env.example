# MangaForge settings - copy to `.env` for local runs (export them, or put them in the shell).
# On GitHub: Settings -> Secrets and variables -> Actions: SECRETS for keys, VARIABLES for the rest (every variable becomes a setting).
# Everything below shows the DEFAULT; remove the leading # to change it.

# ---- secrets (GitHub: Secrets tab)
# GEMINI_API_KEY=            # free key from aistudio.google.com  (story, script, vision for eyes/panels) - up to 3: _2, _3
# HORDE_API_KEY=             # optional: AI Horde account key (faster queue than the anonymous 0000000000)
# CF_ACCOUNT_ID=  CF_API_TOKEN=   # optional: Cloudflare Workers AI image fallback
# POLLINATIONS_KEY=         # optional
# YT_CLIENT_ID=  YT_CLIENT_SECRET=  YT_REFRESH_TOKEN=   # YouTube upload (see README)

# ---- output format
# FPS=24
# ANIM_STEP=2      # 2 = "on twos": 12 unique drawings/s, the anime look
# VIDEO_W=1920
# VIDEO_H=1080
# SHORT_SECONDS=120      # one daily short
# PARTS_PER_EPISODE=7      # 7 shorts = 1 weekly episode
# VERTICAL=1      # also export a 9:16 cut (Shorts/Reels/TikTok) next to the landscape video
# X264_PRESET=veryfast
# CRF=16

# ---- rendering (Blender)
# BLENDER_BIN=
# RENDER_ENGINE=auto      # auto | cycles | eevee | cv   (cv = no-Blender fallback)
# CYCLES_SAMPLES=24
# RENDER_THREADS=                # empty = all cores
# RENDER_WORKERS=1      # parallel Blender processes (1 is right for Cycles)
# RENDER_STRICT=0      # True: a Blender failure aborts instead of falling back to the cv engine
# RENDER_DENOISE=1
# MOTION_BLUR=1
# RENDER_SCALE=1.0      # <1 for quick drafts (0.5 = 960x540)
# PHYSICS_FX=0      # tier 3: real simulations - Mantaflow smoke + fire, cloth banner (slow on CPU)
# SAVE_BLEND=0      # keep one relative-path .blend per shot (open it in the Blender GUI to polish)
# VIEW_TRANSFORM=Standard      # Standard | AgX | Filmic | ACES (ACES needs an OCIO config in $OCIO)
# VOLUMETRICS=0      # real scattering volume + spot light in epic shots (slow on CPU)
# EXPORT_USD=0      # also write a .usd per shot
# COMPOSITOR=1      # Blender compositor: Glare bloom on the HDR emission (before the ffmpeg grade)
# RENDER_PASSES=0      # also write Z + mist 16-bit EXR passes per drawing (work/<job>/frames/*/passes)
# INK=1      # Freestyle ink lines on the 3D dressing (pebbles, leaves)

# ---- art
# IMAGE_PROVIDER=auto      # auto|horde|pollinations|comfyui|a1111|cloudflare
# ART_W=1344      # native generation size (16:9-ish, multiples of 64)
# ART_H=768
# ART_TARGET_W=3840      # key art is upscaled to about this width
# ART_VARIANTS=1      # candidates per key image (best-of-N picks by sharpness)
# ALLOW_PLACEHOLDER_ART=0
# ART_CONCURRENCY=3      # images requested in parallel
# ART_PLATE_FORMAT=jpg      # jpg (small, default) | png (lossless, big)
# HORDE_URL=https://aihorde.net/api/v2
# HORDE_API_KEY=0000000000      # anonymous key works but queues last
# HORDE_TIMEOUT=1500      # seconds to wait for ONE image
# HORDE_UPSCALE=1      # RealESRGAN anime 4x via the Horde post-processors
# HORDE_STEPS=28
# HORDE_CFG=6.5
# COMFY_URL=http://127.0.0.1:8188
# COMFY_CHECKPOINT=      # file name of an anime SDXL checkpoint in ComfyUI
# A1111_URL=http://127.0.0.1:7860
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# POLLINATIONS_KEY=
# DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf

# ---- image-to-video (optional GPU tier: hero shots get real motion)
# I2V_BACKEND=off      # off | comfyui
# I2V_WORKFLOW=assets/workflows/i2v_api.json
# I2V_BUDGET=6      # max hero shots per short that get AI motion
# I2V_SECONDS=4.0
# I2V_NATIVE_FPS=24      # frame rate the video model was built for (LTX-Video 24, Wan 16)
# I2V_TIMEOUT=3600      # seconds to wait for one clip

# ---- voices
# VOICE_PROVIDER=auto      # auto | voicevox | edge | silent
# VOICEVOX_URL=http://127.0.0.1:50021

# ---- story
# VOICE_LANG=ja
# STORY_SOURCE=manga      # manga (MangaDex, default) | original (invented story)
# MANGA_DIR=assets/manga      # extra local manga pages (used only if MangaDex is unreachable)
# MANGA_ID=      # force a MangaDex title (uuid) instead of the automatic pick
# MANGA_TITLE=      # or search a title by name
# MANGA_LIKE=Kimetsu no Yaiba      # the series the automatic pick should resemble (its tags are the profile)
# MANGA_LANG=en      # translation language read by the vision model
# MANGA_CHAPTERS_PER_EPISODE=2
# MANGA_MIN_CHAPTERS=8      # a candidate needs at least this many readable chapters
# MANGA_VISION_PAGES=14      # pages per vision request
# PILOT=1      # episode 1 / part 1 gets the cold-open + title-card + hook treatment

# ---- eyes (the signature of the look): detection, enhancement, blinks, catch-lights, glow, extreme close-ups
# EYES=1
# EYE_REFINE=1      # second img2img pass over the face of close-ups (needs a provider with img2img)
# EYE_REFINE_MAX=8      # at most this many images per short get the extra pass
# ART_REFS=1      # manga/cover character crops guide hero portraits (img2img) when supported
# PUBLISH_TZ=Asia/Riyadh
# PEAK_SLOTS=19:00,21:30
# DRY_RUN=0
# AUTO_WEEKLY=1      # join the 7 shorts as soon as the 7th exists
